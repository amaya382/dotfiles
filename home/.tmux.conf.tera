### .tmux.conf for all ###

# general
## prefix
if-shell '[ -z "${ANYRC_HOME}" ]' \
  'set -g prefix C-f' \
  'set -g prefix C-v'

## disable detach
unbind -T root C-d

## shell: set in the per-OS section below, since zsh's path differs by OS.
set -g default-terminal "screen-256color"
#set -ga terminal-overrides ",*xterm*:Tc"

## reload (TODO: reload zshrc on all windows)
if-shell '[ -z "${ANYRC_HOME}" ]' \
  'bind r source-file ~/.tmux.conf \; set synchronize-panes on \; send-keys "source ~/.zshrc" Enter \; set synchronize-panes off \; display-message "Reload Config!!"' \
  'bind r source-file ${ANYRC_HOME}/.tmux.conf \; set synchronize-panes on \; send-keys "source ${ANYRC_HOME}/.zshrc" Enter \; set synchronize-panes off \; display-message "Reload Config!!"'

## copy-paste
bind f copy-mode
setw -g mode-keys vi

## delay
set -sg escape-time 0

# key bind
## new pane
bind c new-window -c "#{pane_current_path}" # just change path

## split
bind v split-window -v -c "#{pane_current_path}"
bind h split-window -h -c "#{pane_current_path}"

## adjust size
bind C-s resize-pane -L 5
bind C-d resize-pane -D 5
bind C-e resize-pane -U 5
bind C-f resize-pane -R 5

## maximize panel
bind -n C-w resize-pane -Z
## choose window
#bind -n C-w choose-window

## move on window
bind -n C-b select-window -t :-
bind -n C-n select-window -t :+

## move on panel
bind -n C-o select-pane -t :.+

## swap windows
bind b swap-window -t -1
bind n swap-window -t +1

# pack windows' order
set -g renumber-windows on

# tpack (tmux plugin manager)
## plugin conf
### resurrect
set -g @resurrect-save 'S'
set -g @resurrect-restore 'R'
set -g @resurrect-capture-pane-contents 'on'

### continuum
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

### theme
set -g @themepack 'powerline/block/cyan'

### mouse
set -g mouse on

## The zsh line editor keeps mouse reporting on at the prompt (see
## ~/.zsh-mouse.zsh), which raises #{mouse_any_flag} and makes the default
## bindings forward drags and the wheel to zsh. Swapping that condition for
## #{alternate_on} keeps both with tmux at the prompt, so a plain drag still
## opens copy-mode and the wheel still scrolls, while full-screen programs
## such as vim keep receiving mouse events. A click is a separate event
## (MouseDown1Pane) and stays forwarded, which is what moves the cursor.
bind -n MouseDrag1Pane if -F '#{||:#{pane_in_mode},#{alternate_on}}' { send -M } { copy-mode -M }
bind -n WheelUpPane    if -F '#{||:#{pane_in_mode},#{alternate_on}}' { send -M } { copy-mode -e }

### keyboard selection
## Shift+arrow is the keyboard counterpart of the drag above: it opens
## copy-mode, anchors the selection at the cursor and extends it one cell,
## so text can be selected without reaching for the mouse. Full-screen
## programs keep the keys, gated on the same #{alternate_on} as the drag.
bind -n S-Left  if -F '#{alternate_on}' { send S-Left }  { copy-mode ; send -X begin-selection ; send -X cursor-left }
bind -n S-Right if -F '#{alternate_on}' { send S-Right } { copy-mode ; send -X begin-selection ; send -X cursor-right }
bind -n S-Up    if -F '#{alternate_on}' { send S-Up }    { copy-mode ; send -X begin-selection ; send -X cursor-up }
bind -n S-Down  if -F '#{alternate_on}' { send S-Down }  { copy-mode ; send -X begin-selection ; send -X cursor-down }

## Once the pane is in copy-mode the root table no longer sees these keys, so
## copy-mode-vi repeats them to keep extending the selection. The
## #{selection_present} branch anchors one first, for copy-mode entered by
## another route such as the f binding.
bind -T copy-mode-vi S-Left  if -F '#{selection_present}' { send -X cursor-left }  { send -X begin-selection ; send -X cursor-left }
bind -T copy-mode-vi S-Right if -F '#{selection_present}' { send -X cursor-right } { send -X begin-selection ; send -X cursor-right }
bind -T copy-mode-vi S-Up    if -F '#{selection_present}' { send -X cursor-up }    { send -X begin-selection ; send -X cursor-up }
bind -T copy-mode-vi S-Down  if -F '#{selection_present}' { send -X cursor-down }  { send -X begin-selection ; send -X cursor-down }

# enable plugins
set -g @tpm_plugins '           \
  jimeh/tmux-themepack          \
  tmux-plugins/tmux-resurrect   \
  tmux-plugins/tmux-continuum   \
'

if-shell '[ -z "${ANYRC_HOME}" ]' \
  "run 'tpack init'" ''

{%- if os() == "linux" %}

### .tmux.conf for linux ###

# general
## shell: zsh lives at /usr/bin/zsh here; fall back to bash when it is absent.
if-shell '[ -x /usr/bin/zsh ]' \
  'set -g default-shell /usr/bin/zsh' \
  'set -g default-shell /bin/bash'

## copy-paste
if-shell '[ "$(uname -a | grep -i Microsoft)" != "" ]' \
  'bind-key -T copy-mode-vi Enter send -X copy-pipe-and-cancel "win32yank.exe -i"' \
  'bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "xsel -bi"'

{%- elif os() == "macos" %}

### .tmux.conf for osx ###

# general
## shell: macOS ships zsh at /bin/zsh. default-command is left empty so that
## default-shell is the value tmux uses for new windows, which also drops the
## dependency on reattach-to-user-namespace being on the server's PATH. tmux
## has reattached to the per-user bootstrap namespace itself since 2.6, so the
## wrapper only duplicates what the server already does.
set-option -g default-shell /bin/zsh

{%- endif %}
